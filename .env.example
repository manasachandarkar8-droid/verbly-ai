# Copy to .env and adjust for your environment.

VERBLY_APP_NAME="Verbly AI Backend"
VERBLY_ENVIRONMENT=development
VERBLY_DEBUG=false

VERBLY_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3002"]

VERBLY_DATABASE_URL=postgresql+psycopg://verbly:verbly@localhost:5432/verbly

# Feature 1 (extraction) settings
VERBLY_USER_AGENT=VerblyAI/1.0
VERBLY_FETCH_TIMEOUT_SECONDS=10
VERBLY_FETCH_CONNECT_TIMEOUT_SECONDS=5
VERBLY_MAX_RESPONSE_BYTES=5242880
VERBLY_MAX_REDIRECTS=5

# Feature 4 (grammar) settings
# Base URL of the self-hosted LanguageTool HTTP server.
# Use http://localhost:8010 when running FastAPI directly on Windows
# while LanguageTool runs in Docker.
VERBLY_LANGUAGETOOL_BASE_URL=http://localhost:8010
VERBLY_LANGUAGETOOL_TIMEOUT_SECONDS=15
VERBLY_LANGUAGETOOL_CONNECT_TIMEOUT_SECONDS=5

# Feature 5: AI Content Analysis
VERBLY_GROQ_API_KEY=
VERBLY_CLOUDFLARE_ACCOUNT_ID=
VERBLY_CLOUDFLARE_API_TOKEN=

# Feature 6: AI Content Rewrite
VERBLY_REWRITE_GROQ_API_KEY=
VERBLY_REWRITE_CLOUDFLARE_ACCOUNT_ID=
VERBLY_REWRITE_CLOUDFLARE_API_TOKEN=
VERBLY_REWRITE_PROVIDER_TIMEOUT_SECONDS=80
VERBLY_REWRITE_REDIS_URL=